# Copy to .env and adjust. Every setting is optional.

# Where the database and the generated secret key live (default: ./data)
# NEJACHEQUE_DATA_DIR=./data

# Key that encrypts stored secrets (Bale bot token, SMS API key). If empty, a random key is
# generated once in the data folder. Keep it with your backups.
# NEJACHEQUE_SECRET_KEY=

# Set to 1 when the site is served over HTTPS
# NEJACHEQUE_COOKIE_SECURE=0

# How long a sign-in lasts, in days
# NEJACHEQUE_SESSION_DAYS=14

# Daily Bale / SMS reminders (they still have to be switched on in Settings)
# NEJACHEQUE_REMINDERS=1

# Port used by run.bat / run.sh / docker-compose
# PORT=8080
